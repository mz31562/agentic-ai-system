# ============================================================
# AGENTIC AI SYSTEM — Environment Configuration
# Copy this to .env and fill in your values
# In VSCode: make sure line endings are LF not CRLF
# (bottom-right of VSCode, click CRLF and switch to LF)
# ============================================================

# --- General ---
DEBUG_MODE=false

# --- App mode: "cli" or "api" ---
# cli = interactive terminal
# api = FastAPI server (for React frontend)
APP_MODE=cli

# ============================================================
# LLM BACKENDS — enable at least one
# ============================================================

# Groq (free, fast — recommended for getting started)
LLM_GROQ_ENABLED=true
LLM_GROQ_API_KEY=your_groq_api_key_here
LLM_GROQ_MODELS=llama-3.1-70b-versatile,llama-3.1-8b-instant

# Ollama (free, local, private)
LLM_OLLAMA_ENABLED=false
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODELS=llama3

# Claude (best quality, paid)
LLM_CLAUDE_ENABLED=false
LLM_CLAUDE_API_KEY=your_anthropic_api_key_here
LLM_CLAUDE_MODELS=claude-haiku-4-5-20251001

# OpenAI (paid)
LLM_OPENAI_ENABLED=false
LLM_OPENAI_API_KEY=your_openai_api_key_here
LLM_OPENAI_MODELS=gpt-4o-mini

# HuggingFace (free inference API, slow)
LLM_HUGGINGFACE_ENABLED=false
LLM_HUGGINGFACE_API_KEY=your_hf_token_here
LLM_HUGGINGFACE_MODELS=mistralai/Mistral-7B-Instruct-v0.2

# ============================================================
# LLM ROUTING PREFERENCES
# ============================================================
LLM_BACKEND_PRIORITY=groq,ollama,openai,claude,huggingface
LLM_PREFER_FAST=true
LLM_PREFER_LOCAL=false
LLM_MAX_COST_PER_REQUEST=0.05
LLM_DAILY_BUDGET=5.00
LLM_WARN_AT_PERCENT=80
LLM_ALLOW_PAID=true

# ============================================================
# IMAGE GENERATION
# Options: comfyui | dalle | replicate | segmind | mock
# ============================================================
IMAGE_BACKEND=comfyui
IMAGE_MODEL=sdxl
IMAGE_OUTPUT_DIR=generated_images
DEFAULT_IMAGE_SIZE=1024x1024
DEFAULT_IMAGE_STYLE=vivid
IMAGE_MAX_RETRIES=3
IMAGE_TIMEOUT_SECONDS=600
IMAGE_ENABLE_FALLBACK=true
ENABLE_TEXT_OPTIMIZATION=true

# ComfyUI (local)
COMFYUI_URL=http://127.0.0.1:8188
# When running via Docker Compose use:
# COMFYUI_URL=http://comfyui:8188

# API key for dalle / replicate / segmind
IMAGE_API_KEY=

# ============================================================
# API SERVER (used when APP_MODE=api)
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000